name: Build-Test-Release (Assignment 5 - Grade A)

on:
  push:
    branches: [ master ]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: deploy-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  # === Step 1：Build ===
  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install and Build
        run: |
          echo "📦 Installing dependencies and building project..."
          npm ci || npm install
          npm run build --if-present

      - name: Archive Build Artifact
        run: zip -r build.zip . -x ".git/*" "node_modules/*"

      - uses: actions/upload-artifact@v4
        with:
          name: build-artifact
          path: build.zip
          retention-days: 7

  # === Step 2：Automated Test ===
  test:
    name: Automated Test
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: build-artifact

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Test Dependencies
        run: |
          npm ci || npm install

      - name: Run Automated Tests
        run: |
          echo "🧪 Running automated tests..."
          npm test || (echo "❌ Tests failed — stopping pipeline." && exit 1)

  # === Step 3：Release to Dev ===
  release:
    name: Release to Dev
    needs: test
    runs-on: ubuntu-latest
    if: success()          # 只有測試全通過才會執行
    environment:
      name: dev
      url: ${{ format('https://github.com/{0}/releases', github.repository) }}

    steps:
      - uses: actions/download-artifact@v4
        with:
          name: build-artifact

      - name: Setup GitHub CLI
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Create Dev Release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
        run: |
          set -e
          TAG="dev-$(date +%s)"
          echo "✅ Tests passed. Releasing build as $TAG ..."
          gh auth status || gh auth login --with-token <<< "$GH_TOKEN"
          gh release create "$TAG" build.zip --notes "Automated dev release after successful tests" --repo "$REPO"

      - name: Notify Slack (success)
        if: success()
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          REPO: ${{ github.repository }}
          RUN_ID: ${{ github.run_id }}
        run: |
          MESSAGE="✅ *Dev Release Successful!*%0A• Repository: https://github.com/${REPO}/actions/runs/${RUN_ID}"
          curl -s -X POST -H 'Content-type: application/json' \
            --data "{\"text\":\"${MESSAGE}\"}" \
            "$SLACK_WEBHOOK_URL" || echo "⚠️ Slack notification failed."

      - name: Notify Slack (failure)
        if: failure()
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          REPO: ${{ github.repository }}
          RUN_ID: ${{ github.run_id }}
        run: |
          MESSAGE="❌ *Dev Release Failed!*%0A• Check logs: https://github.com/${REPO}/actions/runs/${RUN_ID}"
          curl -s -X POST -H 'Content-type: application/json' \
            --data "{\"text\":\"${MESSAGE}\"}" \
            "$SLACK_WEBHOOK_URL" || echo "⚠️ Slack notification failed."
